+
+// Only the TCP peer may claim the routed UDP association; pin its port too.
+type routedUDPClient struct {
+	*net.UDPConn
+	peer net.IP
+	port int
+}
+
+func (c *routedUDPClient) ReadFrom(b []byte) (int, net.Addr, error) {
+	for {
+		n, addr, err := c.ReadFromUDP(b)
+		if err != nil {
+			return 0, nil, err
+		}
+		if !addr.IP.Equal(c.peer) || (c.port != 0 && addr.Port != c.port) {
+			continue
+		}
+		c.port = addr.Port
+		return n, addr, nil
+	}
+}
