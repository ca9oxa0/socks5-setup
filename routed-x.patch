diff --git a/handler/socks/v5/source_route.go b/handler/socks/v5/source_route.go
new file mode 100644
index 0000000..0881895
--- /dev/null
+++ b/handler/socks/v5/source_route.go
@@ -0,0 +1,158 @@
+package v5
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"strings"
+
+	"github.com/go-gost/core/chain"
+	"github.com/go-gost/core/common/net/dialer"
+)
+
+type sourcePolicy struct {
+	mode  string
+	users map[string]netip.Addr
+}
+
+var routePolicy *sourcePolicy
+
+// SourceRoutingEnabled reports whether the SOCKS5 source policy was loaded.
+func SourceRoutingEnabled() bool { return routePolicy != nil }
+
+// ConfigureSourceRouting is called once, before starting any SOCKS5 service.
+func ConfigureSourceRouting(path string) error {
+	p, err := readSourcePolicy(path)
+	if err != nil {
+		return fmt.Errorf("SOCKS5_ROUTE_FILE: %w", err)
+	}
+	routePolicy = p
+	return nil
+}
+
+func readSourcePolicy(path string) (*sourcePolicy, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+
+	p := &sourcePolicy{users: make(map[string]netip.Addr)}
+	var assigned map[netip.Addr]bool
+	s := bufio.NewScanner(f)
+	for line := 1; s.Scan(); line++ {
+		text := strings.TrimSpace(s.Text())
+		if text == "" || strings.HasPrefix(text, "#") {
+			continue
+		}
+		if p.mode == "" {
+			switch text {
+			case "username", "ingress":
+				p.mode = text
+			default:
+				return nil, fmt.Errorf("line %d: expected username or ingress", line)
+			}
+			continue
+		}
+		if p.mode != "username" {
+			return nil, fmt.Errorf("line %d: ingress takes no records", line)
+		}
+		username, rawIP, ok := strings.Cut(s.Text(), "=")
+		if !ok || username == "" {
+			return nil, fmt.Errorf("line %d: expected username=IP", line)
+		}
+		ip, err := netip.ParseAddr(strings.TrimSpace(rawIP))
+		ip = ip.Unmap()
+		if err != nil || ip.Zone() != "" || !validSource(ip) || (ip.Is6() && ip.IsLinkLocalUnicast()) {
+			return nil, fmt.Errorf("line %d: invalid or scoped source IP", line)
+		}
+		if _, exists := p.users[username]; exists {
+			return nil, fmt.Errorf("line %d: duplicate username", line)
+		}
+		if assigned == nil {
+			assigned, err = assignedSourceIPs()
+			if err != nil {
+				return nil, err
+			}
+		}
+		if !assigned[ip] {
+			return nil, fmt.Errorf("line %d: source IP %s is not assigned locally", line, ip)
+		}
+		p.users[username] = ip
+	}
+	if err := s.Err(); err != nil {
+		return nil, err
+	}
+	if p.mode == "" {
+		return nil, errors.New("expected username or ingress")
+	}
+	return p, nil
+}
+
+func assignedSourceIPs() (map[netip.Addr]bool, error) {
+	addrs, err := net.InterfaceAddrs()
+	if err != nil {
+		return nil, err
+	}
+	assigned := make(map[netip.Addr]bool, len(addrs))
+	for _, addr := range addrs {
+		if prefix, err := netip.ParsePrefix(addr.String()); err == nil {
+			assigned[prefix.Addr().Unmap()] = true
+		}
+	}
+	return assigned, nil
+}
+
+func validSource(ip netip.Addr) bool {
+	return ip.IsValid() && !ip.IsUnspecified() && !ip.IsMulticast() && ip.String() != "255.255.255.255"
+}
+
+func (p *sourcePolicy) source(local net.Addr, s *serverSelector) (*net.TCPAddr, error) {
+	if !s.authenticated {
+		return nil, errors.New("socks5 source routing: authentication required")
+	}
+	localTCP, ok := local.(*net.TCPAddr)
+	if !ok {
+		return nil, errors.New("socks5 source routing: a TCP listener is required")
+	}
+	ip := localTCP.AddrPort().Addr().Unmap()
+	if p.mode == "username" {
+		ip, ok = p.users[s.username]
+		if !ok {
+			return nil, errors.New("socks5 source routing: no mapping for authenticated username")
+		}
+	}
+	if !validSource(ip) {
+		return nil, errors.New("socks5 source routing: invalid source IP")
+	}
+	assigned, err := assignedSourceIPs()
+	if err != nil {
+		return nil, err
+	}
+	if !assigned[ip.WithZone("")] {
+		return nil, errors.New("socks5 source routing: source IP is not assigned locally")
+	}
+	return &net.TCPAddr{IP: ip.AsSlice(), Zone: ip.Zone()}, nil
+}
+
+func (h *socks5Handler) dialRoutedTCP(ctx context.Context, address string, source *net.TCPAddr) (net.Conn, error) {
+	opts := h.router.Options()
+	address, err := chain.Resolve(ctx, "ip", address, opts.Resolver, opts.HostMapper, opts.Logger)
+	if err != nil {
+		return nil, err
+	}
+	timeout := opts.Timeout
+	if timeout <= 0 {
+		timeout = dialer.DefaultTimeout
+	}
+	d := net.Dialer{LocalAddr: source, Timeout: timeout}
+	network := "tcp6"
+	if source.IP.To4() != nil {
+		network = "tcp4"
+	}
+	return d.DialContext(ctx, network, address)
+}
